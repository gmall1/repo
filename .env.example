# ──────────────────────────────────────────────────────────────────────────
# Required
# ──────────────────────────────────────────────────────────────────────────

# Postgres connection string
DATABASE_URL=postgres://postgres:password@localhost:5432/repo

# Random 32+ byte hex string for signing session cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=replace-me

# Public URL of this Repo instance (used in clone URLs, emails, etc)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Where bare git repos are stored on disk
REPO_STORAGE_PATH=./data/repos

# ──────────────────────────────────────────────────────────────────────────
# Optional: AI features (PR review/summary, issue triage, commit messages)
#
# Repo speaks the OpenAI chat-completions API. Any compatible provider works:
# OpenAI, Groq (free tier), OpenRouter, Together, local Ollama, etc.
#
# Pick ONE of the configurations below and leave the others blank.
# ──────────────────────────────────────────────────────────────────────────

# ── Groq (free tier, fast Llama models) ──
# Get a key at https://console.groq.com/keys
# GROQ_API_KEY=gsk_xxx
# AI_MODEL=llama-3.3-70b-versatile

# ── OpenAI ──
# OPENAI_API_KEY=sk-xxx
# AI_MODEL=gpt-4o-mini

# ── Any OpenAI-compatible provider (OpenRouter, Together, Ollama, …) ──
# AI_API_KEY=...
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=anthropic/claude-3.5-sonnet

# ──────────────────────────────────────────────────────────────────────────
# Optional: transactional email (verification, password reset)
# ──────────────────────────────────────────────────────────────────────────
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=noreply@example.com
